# ─────────────────────────────────────────────────────────────
# Chheda Jewellers — environment variables (example)
# Copy to .env.local and fill in. Never commit real secrets.
# Everything here is OPTIONAL — the site builds and runs without it,
# using safe fallbacks. These wire up the "live data" features.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="https://www.chhedajewellers.com"

# ── Live Gold Rate (see src/lib/gold-rate.ts) ────────────────
# Provider is pluggable. Add a key to switch from the indicative
# fallback to a live feed. Suggested providers: metals.dev, GoldAPI.io.
GOLD_RATE_PROVIDER="fallback"          # "fallback" | "metals-dev" | "goldapi"
GOLD_RATE_API_KEY=""
GOLD_RATE_CITY="Mumbai"

# ── Analytics / A/B (PostHog — see src/lib/analytics.ts) ─────
# Leave blank to disable analytics entirely (no-op).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Maps (Mapbox — see src/components/sections/Branches) ─────
# Optional. The branches section renders a designed map without it.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── CMS (Sanity — future) ────────────────────────────────────
# NEXT_PUBLIC_SANITY_PROJECT_ID=""
# NEXT_PUBLIC_SANITY_DATASET="production"
